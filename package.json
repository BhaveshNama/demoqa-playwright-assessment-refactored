{
  "name": "demoqa-playwright-assessment",
  "version": "1.1.0",
  "private": true,
  "description": "QA Technical Assessment using Playwright and TypeScript",
  "scripts": {
    "test": "playwright test",
    "test:ui": "playwright test --grep @UI",
    "test:api": "playwright test --grep @API",
    "test:practice-form": "playwright test tests/ui/studentRegistration.spec.ts",
    "test:headed": "playwright test --headed",
    "test:parallel": "playwright test --workers=2",
    "typecheck": "tsc --noEmit",
    "report": "playwright show-report"
  },
  "devDependencies": {
    "@faker-js/faker": "^10.0.0",
    "@playwright/test": "^1.63.0",
    "@types/node": "^24.0.0",
    "typescript": "^5.9.2"
  }
}
